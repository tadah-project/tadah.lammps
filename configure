#!/bin/sh
CORE_URL=https://git.ecdf.ed.ac.uk/tadah/core.git
MODELS_URL=https://git.ecdf.ed.ac.uk/tadah/models.git
MD_URL=https://git.ecdf.ed.ac.uk/tadah/md.git
if ! git clone $CORE_URL CORE 2>/dev/null && [ -d CORE ] ; then  echo Skiping CORE clone as directory exists;  fi
if ! git clone $MODELS_URL MODELS 2>/dev/null && [ -d MODELS ] ; then  echo Skipping MODELS clone as directory exists;  fi
if ! git clone $MD_URL MD 2>/dev/null && [ -d MD ] ; then  echo Skipping MD clone as directory exists;  fi
cp Makefile.in Makefile
sed -i '1s/^/TADAH_MD_CONFIGURED=true\n/' Makefile
mkdir -p build
echo Configure done!
echo Run make to compile
